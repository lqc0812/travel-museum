# ===== 服务端口 =====
PORT=3000

# ===== 管理员密码（仅服务端使用，绝不写进前端）=====
# 请改成你自己的强密码
ADMIN_PASSWORD=change_me_strong_password

# ===== 用于签发管理员登录 token 的密钥（请改成一段足够长的随机字符串）=====
JWT_SECRET=replace_with_a_long_random_secret_string

# ===== 可选：本地存储路径（不配 R2 时使用，exe 本地/局域网模式可不管）=====
# DB_PATH=/data/museum.db
# UPLOADS_DIR=/data/uploads

# ===== 可选：Cloudflare R2 外部存储（配齐这 5 项即启用云端持久存储，Render 免费档也持久）=====
# 在 Cloudflare 控制台「R2」创建 bucket 并生成 API 令牌后填入：
# R2_ACCOUNT_ID=你的账户ID
# R2_ACCESS_KEY_ID=你的R2访问密钥ID
# R2_SECRET_ACCESS_KEY=你的R2私密密钥
# R2_BUCKET=你的bucket名称
# R2_PUBLIC_URL=https://你的bucket公开访问地址（如 https://xxx.r2.dev 或绑定的自定义域名）
